{
  "name": "flyhigh-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Upload a 3D model and generate a realistic studio photograph of a real-world version of it.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "three": "^0.170.0",
    "vite": "^6.0.7"
  },
  "engines": {
    "node": ">=20"
  }
}
