# Claude (recommended): identifies the object and writes the photographer's brief.
# Claude doesn't draw images, so you also need at least one image engine key below.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# Image engines: set at least ONE. The UI only offers engines whose key is set.
OPENAI_API_KEY=
GEMINI_API_KEY=
REPLICATE_API_TOKEN=

# Optional model overrides
# OPENAI_IMAGE_MODEL=gpt-image-1
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# REPLICATE_MODEL=black-forest-labs/flux-depth-pro

# Optional: require this code in the UI before generating (protects your API credits)
ACCESS_CODE=

PORT=3001
